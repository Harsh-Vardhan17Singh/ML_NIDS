# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/.cache/

# Data directories (sensitive, raw captures, or large benchmark datasets)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
dataset/


# Local database files
*.sqlite
*.sqlite3
*.db
backend/app/sentinelnids.db

# Machine Learning artifacts (large binaries)
ml/artifacts/*.joblib
ml/artifacts/*.pkl
ml/artifacts/*.onnx
!ml/artifacts/.gitkeep

# Logs and runtime files
*.log
logs/
.system_generated/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test & coverage
.pytest_cache/
.coverage
htmlcov/
