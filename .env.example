# SentinelNIDS Environment Configuration Template
# Copy this file to .env and replace placeholder values with environment-specific secrets.
# NEVER commit the active .env file to version control.

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Backend & Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL in staging/production, SQLite permitted for isolated dev/tests)
DATABASE_URL=postgresql://sentinel_user:change_password@localhost:5432/sentinelnids_db
# DATABASE_URL=sqlite:///./sentinelnids_dev.db

# Ingestion & Sensor Authentication
SENSOR_ID=lab-sensor-01
# Scoped sensor API token for flow ingestion (hashed on server side)
INGESTION_TOKEN=change_me_sensor_ingestion_token_secret_value
MAX_INGEST_BATCH_SIZE=500
MAX_PCAP_SIZE_MB=250

# ML Inference & Model Registry
MODEL_REGISTRY_PATH=./ml/artifacts
ACTIVE_MODEL_VERSION=flow-v1.0.0
FEATURE_SCHEMA_VERSION=1.0

# Detection Engine Configuration
RULE_CONFIG_PATH=./detection/rules.yaml

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

